# 所有值均为本地开发示例，生产环境由部署方通过环境变量/密钥管理注入（KICKOFF §3.3）
CF_META_DB_URL=mysql+pymysql://cellflow:change_me@127.0.0.1:3306/cellflow_meta?charset=utf8mb4
CF_REDIS_URL=redis://127.0.0.1:6379/0
# 对象存储：local（本地目录）或 s3
CF_STORAGE_BACKEND=local
CF_STORAGE_LOCAL_DIR=./data/storage
CF_S3_ENDPOINT=
CF_S3_BUCKET=cellflow
CF_S3_ACCESS_KEY=
CF_S3_SECRET_KEY=
# 控制台高危操作口令（D19）
CF_OP_TOKEN=change_me
# 控制台直接填写的数据库口令的加密主密钥（更换后需在控制台重新填写口令）
CF_SECRET_KEY=change_me
# 数据源 / 调用方引用名对应的真实值，格式：CF_REF_<引用名大写>
# 例：数据源 host_ref=biz_mysql → CF_REF_BIZ_MYSQL=mysql+pymysql://user:pass@host:3306
CF_REF_BIZ_MYSQL=mysql+pymysql://cellflow:change_me@127.0.0.1:3306
CF_REF_DEMO_APP_SECRET=change_me
